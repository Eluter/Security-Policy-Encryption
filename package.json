{
  "name": "@eluter/security-encrypt",
  "version": "0.1.0",
  "description": "CLI to encrypt vulnerability reports with PGP for security@eluter.com. Runs from anywhere via npx, no gpg required.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "security-encrypt": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "pgp",
    "openpgp",
    "encryption",
    "security",
    "vulnerability",
    "responsible-disclosure",
    "eluter"
  ],
  "dependencies": {
    "openpgp": "6.3.1"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "5.9.3"
  }
}
